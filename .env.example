# Used by the api container 
ConnectionStrings__Default=Host=postgres;Port=5432;Database=helpdesk;Username=postgres;Password=changeme123
Jwt__Key=replace-with-a-long-random-secret-at-least-32-characters
ASPNETCORE_ENVIRONMENT=Development